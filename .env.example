# Copy this file to .env and fill in your keys.
#   cp .env.example .env
# Groq (free, no card): https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
# Tavily web search (free tier): https://app.tavily.com
TAVILY_API_KEY=tvly-your_key_here

# Supabase (pipeline + Netlify Functions only — never expose service role in the SPA)
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Netlify Functions: protect DELETE /api/deals and POST /api/fetch
ADMIN_SECRET=choose_a_long_random_string

# Optional: server-side GitHub workflow dispatch (Phase 6)
GITHUB_PAT=
GITHUB_OWNER=Garry-j-code
GITHUB_REPO=funding-blotter
GITHUB_WORKFLOW=daily.yml
